---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const menuLinks = [
  { href: '#hero', label: 'Accueil', index: '01' },
  { href: '#experiences', label: 'Expériences', index: '02' },
  { href: '#skills', label: 'Compétences', index: '03' },
  { href: '#projects', label: 'Projets réalisés', index: '04' },
  { href: '#offscreen', label: 'Hors écran', index: '05' },
  { href: '#photos', label: 'Photographie', index: '06' },
  { href: '#music', label: 'Musique', index: '07' },
  { href: '#contact', label: 'Contact', index: '08' },
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fragment+Mono&display=swap"
    />
  </head>
  <body data-load-state="loading">
    <!-- Curtain loader — first visit only -->
    <div class="loader" data-loader aria-hidden="true">
      <div class="loader__panel" data-loader-panel>
        <div class="loader__monogram" aria-hidden="true">
          <span class="loader__slot">
            <img class="loader__logo" src="/logo.svg" alt="" data-loader-char />
          </span>
        </div>
        <p class="loader__meta meta" data-loader-meta>
          Software Engineer
        </p>
      </div>
      <div class="loader__curve" data-loader-curve></div>
    </div>

    <!-- Page transition: rust panel (the only large accent surface) -->
    <div class="transition" data-transition aria-hidden="true">
      <div class="transition__panel" data-transition-panel></div>
    </div>

    <!-- Progressive blur header -->
    <header class="site-header">
      <div class="site-header__blur" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="site-header__bar container">
        <a href="#hero" class="site-header__brand display" data-nav-link>
          FG
        </a>
        <p class="site-header__clock meta" aria-hidden="true">
          ANNECY — <span data-clock>00:00</span>
        </p>
        <div class="site-header__actions">
          <button
            class="site-header__burger"
            data-menu-toggle
            aria-expanded="false"
            aria-label="Ouvrir le menu"
            aria-controls="site-menu"
          >
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Menu overlay: covers the page with cascading panels -->
    <nav class="menu" id="site-menu" data-menu aria-hidden="true">
      <div class="menu__panels" aria-hidden="true">
        <span class="menu__panel menu__panel--deep" data-menu-panel></span>
        <span class="menu__panel menu__panel--rust" data-menu-panel></span>
        <span class="menu__panel menu__panel--surface" data-menu-panel></span>
      </div>
      <div class="menu__inner container" data-menu-content>
        <ul class="menu__links">
          {menuLinks.map((link) => (
            <li class="menu__item">
              <a href={link.href} class="menu__link display" data-nav-link data-menu-link>
                <span class="menu__index meta">{link.index}</span>
                <span class="mask-line">
                  <span data-menu-label>{link.label}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="menu__meta">
          <div>
            <p class="meta meta--accent">Statut</p>
            <p class="meta">Open to work</p>
            <p class="meta">Annecy, FR</p>
          </div>
          <div>
            <p class="meta meta--accent">Réseaux</p>
            <a
              href="https://github.com/flavontheweb"
              class="meta roll"
              rel="noopener"
              target="_blank"
            >
              <span data-roll-copy>
                <span class="social-inline">
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path
