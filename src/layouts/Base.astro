---
import { Font } from 'astro:assets';
import '../styles/global.css';
import ContactMeta from '../components/ContactMeta.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  showLoader?: boolean;
}

const siteTitle = 'Flavien Gaujard — Portfolio';
const siteDescription =
  'Ingénieur logiciel full-stack avec un intérêt singulier pour le design, la photographie et la musique.';
const {
  title = siteTitle,
  description = siteDescription,
  image = '/preview.png',
  lang = 'fr',
  showLoader = true,
} = Astro.props;
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);

const isHome = Astro.url.pathname === '/';
const homeHref = (hash: string) => (isHome ? hash : `/${hash}`);

const menuLinks = [
  { href: homeHref('#hero'), label: 'Accueil', index: '01' },
  { href: homeHref('#experiences'), label: 'Expériences', index: '02' },
  { href: homeHref('#skills'), label: 'Compétences', index: '03' },
  { href: homeHref('#projects'), label: 'Projets réalisés', index: '04' },
  { href: homeHref('#offscreen'), label: 'Hors écran', index: '05' },
  { href: homeHref('#music'), label: 'Musique', index: '06' },
  { href: homeHref('#photos'), label: 'Photographie', index: '07' },
  { href: homeHref('#contact'), label: 'Contact', index: '08' },
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="Flavien Gaujard" />
    <meta name="apple-mobile-web-app-title" content="Flavien Gaujard" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Flavien Gaujard" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Portfolio de Flavien Gaujard" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Portfolio de Flavien Gaujard" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body data-load-state="loading">
    <!-- Curtain loader — first visit only, skipped on lightweight pages -->
    {showLoader && (
      <div class="loader" data-loader aria-hidden="true">
        <div class="loader__panel">
          <div class="loader__monogram" aria-hidden="true">
            <span class="loader__slot">
              <img class="loader__logo" src="/logo.svg" alt="" data-loader-char />
            </span>
          </div>
          <span class="loader__rule" data-loader-rule></span>
          <p class="loader__meta meta" data-loader-meta>
            Software Engineer
          </p>
        </div>
        <div class="loader__curve" data-loader-curve></div>
      </div>
    )}

    <!-- Progressive blur header -->
    <header class="site-header">
      <div class="site-header__blur" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="site-header__bar container">
        <a href={homeHref('#hero')} class="site-header__brand display" data-nav-link>
          <img
            class="site-header__brand-logo"
            src="/favicon.svg"
            alt="Flavien Gaujard"
            width="32"
            height="32"
          />
        </a>
        {isHome && (
          <p class="site-header__clock meta" aria-hidden="true">
            <span data-clock>21 sept. 23:59</span>
          </p>
        )}
        <div class="site-header__actions">
          <button
            class="site-header__burger"
            data-menu-toggle
            aria-expanded="false"
            aria-label="Ouvrir le menu"
            aria-controls="site-menu"
          >
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Menu overlay: covers the page with cascading panels -->
    <nav class="menu" id="site-menu" data-menu aria-hidden="true">
      <div class="menu__panels" aria-hidden="true">
        <span class="menu__panel menu__panel--deep" data-menu-panel></span>
        <span class="menu__panel menu__panel--rust" data-menu-panel></span>
        <span class="menu__panel menu__panel--surface" data-menu-panel></span>
      </div>
      <div class="menu__inner container" data-menu-content>
        <ul class="menu__links">
          {menuLinks.map((link) => (
            <li class="menu__item">
              <a href={link.href} class="menu__link display" data-nav-link data-menu-link>
                <span class="menu__index meta">{link.index}</span>
                <span class="mask-line">
                  <span data-menu-label>{link.label}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="menu__meta">
          <ContactMeta />
        </div>
        <img class="menu__logo" src="/logo.svg" alt="" aria-hidden="true" />
      </div>
    </nav>

    <!-- Page (slides to reveal the menu) -->
    <div class="page" data-page>
      <main id="main">
        <slot />
      </main>

      <!-- Parallax footer reveal: the footer lives beneath the page -->
      <footer class="site-footer" data-footer id="contact">
        <div class="site-footer__inner container" data-footer-inner>
          <p class="meta meta--accent">Une idée, un projet, un poste ?</p>
          <a href="mailto:contact@flavien-gaujard.fr" class="site-footer__cta display">
            <span class="mask-line">
              <span>Écrivez-moi&nbsp;→</span>
            </span>
          </a>
          <div class="site-footer__grid">
            <ContactMeta />
          </div>
          <div class="site-footer__legal-wrapper">
            <div class="site-footer__legal">
              <p class="meta-copyright">
                <span class="meta-copyright-line">
                  <span class="meta-copyright-icon">©</span>{' '}
                  <span>{new Date().getFullYear()} Flavien GAUJARD.</span>
                </span>
                <span class="meta-copyright-line">Tous droits réservés.</span>
                <a href="/legal" class="meta-copyright-link">
                  Mentions légales et crédits
                </a>
              </p>
            </div>
            <img class="site-footer__logo" src="/logo.svg" alt="" height="40" aria-hidden="true" />
          </div>
        </div>
      </footer>
    </div>

    <slot name="overlay" />

    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>

<style>
  /* ---------- Loader ---------- */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 150;
    pointer-events: none;
  }

  .loader__panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: var(--space-4);
    background: var(--ink-950);
  }

  .loader__monogram {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
  }

  .loader__slot {
    display: block;
    overflow: hidden;
  }

  .loader__logo {
    display: block;
    height: clamp(3rem, 6vw, 5rem);
    width: auto;
  }

  .loader__rule {
    display: block;
    width: clamp(2.5rem, 6vw, 4rem);
    height: 1px;
    margin: 0 auto;
    background: var(--rust-500);
    box-shadow: 0 0 8px 0 var(--rust-400);
    transform-origin: center;
    transform: scaleX(0);
  }

  .loader__meta {
    text-align: center;
    clip-path: inset(0 100% 0 0);
  }

  .loader__curve {
    position: absolute;
    top: 100%;
    left: -5%;
    width: 110%;
    height: 20vw;
    background: var(--ink-950);
    border-radius: 0 0 50% 50%;
    transform-origin: top center;
  }

  body:not([data-load-state='loading']) .loader {
    display: none;
  }

  /* ---------- Header ---------- */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 146;
    transition: opacity 0.4s var(--ease-out);
  }

  .site-header__blur {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .site-header__blur span {
    position: absolute;
    inset: 0;
  }

  .site-header__blur span:nth-child(1) {
    backdrop-filter: blur(1px);
    mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);
  }
  .site-header__blur span:nth-child(2) {
    backdrop-filter: blur(2px);
    mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 85%);
  }
  .site-header__blur span:nth-child(3) {
    backdrop-filter: blur(4px);
    mask-image: linear-gradient(to bottom, black 0%, black 30%, transparent 70%);
  }
  .site-header__blur span:nth-child(4) {
    backdrop-filter: blur(8px);
    mask-image: linear-gradient(to bottom, black 0%, black 18%, transparent 50%);
  }
  .site-header__blur span:nth-child(5) {
    backdrop-filter: blur(16px);
    mask-image: linear-gradient(to bottom, black 0%, transparent 30%);
  }

  .site-header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .site-header__brand {
    font-size: var(--text-lg);
    color: var(--paper-50);
  }

  .site-header__brand-logo {
    display: block;
    width: 32px;
    height: 32px;
  }

  .site-header__clock {
    position: absolute;
    left: var(--margin-x);
    color: var(--paper-50);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-header__burger {
    display: grid;
    gap: 6px;
    padding: var(--space-3);
    margin: calc(var(--space-3) * -1);
    min-width: 44px;
    min-height: 44px;
    align-content: center;
    justify-items: end;
  }

  .site-header__burger span {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--paper-100);
  }

  .site-header__burger span:last-child {
    width: 18px;
  }

  /* ---------- Menu overlay ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 145;
    overflow: clip;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.28s var(--ease-out);
  }

  .menu::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--ink-950);
    opacity: 1;
  }

  .menu[aria-hidden='false'] {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .menu[data-closing='true'] {
    opacity: 1;
    visibility: visible;
  }

  .menu__panels {
    position: absolute;
    inset: 0;
    z-index: 1;
    perspective: 1600px;
  }

  .menu__panel {
    display: block;
    position: absolute;
    inset: 0;
    transform: translate3d(0, 0, 0);
    transform-origin: right center;
    backface-visibility: hidden;
    opacity: 0.96;
    will-change: transform;
  }

  .menu__panel--deep {
    background: var(--ink-950);
    box-shadow: none;
  }

  .menu__panel--rust {
    inset: 0;
    background: var(--rust-500);
    box-shadow: none;
    filter: none;
  }

  .menu__panel--surface {
    inset: 0;
    background:
      radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.08), transparent 42%),
      linear-gradient(
        115deg,
        transparent 62%,
        color-mix(in srgb, var(--rust-500) 18%, transparent) 100%
      ),
      var(--ink-900);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rust-500) 20%, transparent);
  }

  .menu__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-6);
    min-height: 100dvh;
    padding-block: calc(var(--space-7) + var(--space-4)) var(--space-5);
    opacity: 0;
  }

  .menu__links {
    list-style: none;
  }

  .menu__item + .menu__item {
    border-top: 1px solid var(--ink-600);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-2);
    font-size: clamp(1.75rem, 4vw, 3.4375rem);
    color: var(--paper-50);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .menu__link:hover {
    color: var(--rust-400);
  }

  .menu__index {
    min-width: 2ch;
  }

  .menu__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: auto;
  }

  .menu__logo {
    position: absolute;
    right: var(--margin-x);
    bottom: var(--space-5);
    width: clamp(10rem, 16vw, 16rem);
    height: auto;
    pointer-events: none;
  }

  /* ---------- Page ---------- */
  .page {
    position: relative;
    z-index: 10;
    background: var(--ink-950);
    transition: opacity 0.4s var(--ease-out);
  }

  /* ---------- Footer ---------- */
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--ink-900);
    border-top: 1px solid var(--ink-600);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-5);
    will-change: transform;
  }

  .site-footer__cta {
    font-size: var(--text-hero);
    color: var(--paper-50);
    width: fit-content;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-footer__cta:hover {
    color: var(--rust-400);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--ink-600);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .site-footer__legal-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink-600);
  }

  .site-footer__logo {
    display: block;
    margin-top: var(--space-4);
    height: 50px;
  }

  .meta-copyright {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.04em;
    color: var(--ink-300);
  }

  .meta-copyright-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .meta-copyright-icon {
    font-size: var(--text-lg);
    translate: 0 1px;
  }

  .meta-copyright-link {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 767px) {
    .site-header__clock {
      display: none;
    }

    .site-header__bar {
      padding-block: var(--space-3);
    }

    .menu {
      overflow-x: hidden;
      overflow-y: auto;
    }

    .menu__inner {
      min-height: 100dvh;
      gap: var(--space-5);
      padding-block: var(--space-7) 0;
    }

    .menu__link {
      gap: var(--space-3);
      padding-block: var(--space-2);
      font-size: 1.75rem;
    }

    .menu__meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
      margin-top: 0;
    }

    .menu__logo {
      display: none;
    }

    .menu__meta a,
    .site-footer a {
      overflow-wrap: anywhere;
    }

    a[href^='mailto:'] {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    a[href^='mailto:'].roll {
      overflow: visible;
    }

    a[href^='mailto:'].roll [data-roll-copy]:last-child {
      display: none;
    }

    .site-footer__inner {
      gap: var(--space-5);
      padding-block: var(--space-6) var(--space-4);
      will-change: auto;
    }

    .site-footer__cta {
      width: 100%;
      font-size: 2.5rem;
    }

    .site-footer__cta .mask-line {
      overflow: visible;
    }

    .site-footer__cta .mask-line > span {
      text-decoration: underline;
      text-decoration-color: currentColor;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }

    .site-footer__cta:hover {
      color: var(--paper-50);
    }

    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .site-footer__legal-wrapper {
      display: grid;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-4);
      padding-top: var(--space-5);
      text-align: center;
    }

    .site-footer__legal {
      min-width: 0;
      width: 100%;
      justify-content: center;
    }

    .site-footer__logo {
      height: 34px;
      margin-top: 0;
    }

    .meta-copyright {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: var(--space-1);
      width: 100%;
      font-size: 0.6875rem;
      line-height: 1.5;
      letter-spacing: 0.02em;
    }

    .meta-copyright-line {
      align-items: baseline;
      flex-wrap: nowrap;
      line-height: inherit;
    }

    .meta-copyright-icon {
      font-size: inherit;
      margin-right: 0;
      translate: 0 0.08em;
    }

    .meta-copyright-link {
      width: 100%;
      margin-top: var(--space-2);
    }
  }
</style>
