                      fill="currentColor"
                    ></path>
                  </svg>
                  <span>GitHub ↗</span>
                </span>
              </span>
            </a>
            <a href="https://www.linkedin.com/" class="meta roll" rel="noopener" target="_blank">
              <span data-roll-copy>
                <span class="social-inline">
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path
                      d="M6.94 8.5a1.56 1.56 0 1 0 0-3.12 1.56 1.56 0 0 0 0 3.12ZM5.56 10.06h2.75V19H5.56v-8.94Zm4.38 0h2.64v1.22h.04c.37-.7 1.27-1.44 2.61-1.44 2.8 0 3.31 1.88 3.31 4.33V19H15.8v-4.25c0-1.01-.02-2.31-1.38-2.31-1.38 0-1.59 1.1-1.59 2.24V19H9.94v-8.94Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                  <span>LinkedIn ↗</span>
                </span>
              </span>
              <span data-roll-copy aria-hidden="true">
                <span class="social-inline">
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                    <path
                      d="M6.94 8.5a1.56 1.56 0 1 0 0-3.12 1.56 1.56 0 0 0 0 3.12ZM5.56 10.06h2.75V19H5.56v-8.94Zm4.38 0h2.64v1.22h.04c.37-.7 1.27-1.44 2.61-1.44 2.8 0 3.31 1.88 3.31 4.33V19H15.8v-4.25c0-1.01-.02-2.31-1.38-2.31-1.38 0-1.59 1.1-1.59 2.24V19H9.94v-8.94Z"
                      fill="currentColor"
                    ></path>
                  </svg>
                  <span>LinkedIn ↗</span>
                </span>
              </span>
            </a>
          </div>
          <div>
            <p class="meta meta--accent">Contact</p>
            <a href="mailto:contact@flavien-gaujard.fr" class="meta roll">
              <span data-roll-copy>contact@flavien-gaujard.fr ↗</span>
              <span data-roll-copy aria-hidden="true">
                contact@flavien-gaujard.fr ↗
              </span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Page (slides to reveal the menu) -->
    <div class="page" data-page>
      <main id="main">
        <slot />
      </main>

      <!-- Parallax footer reveal: the footer lives beneath the page -->
      <footer class="site-footer" data-footer id="contact">
        <div class="site-footer__inner container" data-footer-inner>
          <p class="meta meta--accent">Une idée, un projet, un poste ?</p>
          <a href="mailto:contact@flavien-gaujard.fr" class="site-footer__cta display">
            <span class="mask-line">
              <span>Écrivez-moi&nbsp;→</span>
            </span>
          </a>
          <div class="site-footer__grid">
            <div>
              <p class="meta meta--accent">Statut</p>
              <p class="meta">Open to work</p>
              <p class="meta">Annecy, FR</p>
            </div>
            <div>
              <p class="meta meta--accent">Réseaux</p>
              <a
                href="https://github.com/flavontheweb"
                class="meta roll"
                rel="noopener"
                target="_blank"
              >
