<style>
  /* ---------- Loader ---------- */
  .loader {
    position: fixed;
    inset: 0;
    z-index: 150;
    pointer-events: none;
  }

  .loader__panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: var(--space-4);
    background: var(--ink-950);
  }

  .loader__monogram {
    display: flex;
    gap: var(--space-2);
    justify-content: center;
  }

  .loader__slot {
    display: block;
    overflow: hidden;
  }

  .loader__slot > span {
    display: block;
  }

  .loader__logo {
    display: block;
    height: clamp(3rem, 6vw, 5rem);
    width: auto;
  }

  .loader__meta {
    text-align: center;
  }

  .loader__curve {
    position: absolute;
    top: 100%;
    left: -5%;
    width: 110%;
    height: 20vw;
    background: var(--ink-950);
    border-radius: 0 0 50% 50%;
    transform-origin: top center;
  }

  body:not([data-load-state='loading']) .loader {
    display: none;
  }

  /* ---------- Transition ---------- */
  .transition {
    position: fixed;
    inset: 0;
    z-index: 140;
    pointer-events: none;
    visibility: hidden;
  }

  .transition__panel {
    position: absolute;
    inset: -2% 0;
    background: var(--rust-500);
    transform: translateY(102%);
  }

  /* ---------- Header ---------- */
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 146;
    transition: opacity 0.4s var(--ease-out);
  }

  .site-header__blur {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .site-header__blur span {
    position: absolute;
    inset: 0;
  }

  .site-header__blur span:nth-child(1) {
    backdrop-filter: blur(1px);
    mask-image: linear-gradient(to bottom, black 0%, black 60%, transparent 100%);
  }
  .site-header__blur span:nth-child(2) {
    backdrop-filter: blur(2px);
    mask-image: linear-gradient(to bottom, black 0%, black 45%, transparent 85%);
  }
  .site-header__blur span:nth-child(3) {
    backdrop-filter: blur(4px);
    mask-image: linear-gradient(to bottom, black 0%, black 30%, transparent 70%);
  }
  .site-header__blur span:nth-child(4) {
    backdrop-filter: blur(8px);
    mask-image: linear-gradient(to bottom, black 0%, black 18%, transparent 50%);
  }
  .site-header__blur span:nth-child(5) {
    backdrop-filter: blur(16px);
    mask-image: linear-gradient(to bottom, black 0%, transparent 30%);
  }

  .site-header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .site-header__brand {
    font-size: var(--text-lg);
    color: var(--paper-50);
  }

  .site-header__clock {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-header__cta {
    color: var(--paper-100);
  }

  .site-header__burger {
    display: grid;
    gap: 6px;
    padding: var(--space-3);
    margin: calc(var(--space-3) * -1);
    min-width: 44px;
    min-height: 44px;
    align-content: center;
    justify-items: end;
  }

  .site-header__burger span {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--paper-100);
  }

  .site-header__burger span:last-child {
    width: 18px;
  }

  /* ---------- Menu overlay ---------- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 145;
    overflow: clip;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.28s var(--ease-out);
  }

  .menu::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--ink-950);
    opacity: 1;
  }

  .menu[aria-hidden='false'] {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .menu[data-closing='true'] {
    opacity: 1;
    visibility: visible;
  }

  .menu__panels {
    position: absolute;
    inset: 0;
    z-index: 1;
    perspective: 1600px;
  }

  .menu__panel {
    display: block;
    position: absolute;
    inset: 0;
    transform: translate3d(0, 0, 0);
    transform-origin: right center;
    backface-visibility: hidden;
    opacity: 0.96;
    will-change: transform;
  }

  .menu__panel--deep {
    background: var(--ink-950);
    box-shadow: none;
  }

  .menu__panel--rust {
    inset: 0;
    background: var(--rust-500);
    box-shadow: none;
    filter: none;
  }

  .menu__panel--surface {
    inset: 0;
    background:
      radial-gradient(circle at 20% 15%, rgba(255, 255, 255, 0.08), transparent 42%),
      linear-gradient(
        115deg,
        transparent 62%,
        color-mix(in srgb, var(--rust-500) 18%, transparent) 100%
      ),
      var(--ink-900);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rust-500) 20%, transparent);
  }

  .menu__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-6);
    min-height: 100dvh;
    padding-block: calc(var(--space-7) + var(--space-4)) var(--space-5);
    opacity: 0;
  }

  .menu__links {
    list-style: none;
  }

  .menu__item + .menu__item {
    border-top: 1px solid var(--ink-600);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-2);
    font-size: clamp(1.75rem, 4vw, 3.4375rem);
    color: var(--paper-50);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .menu__link:hover {
    color: var(--rust-400);
  }

  .menu__index {
    min-width: 2ch;
  }

  .menu__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: auto;
  }

  .menu__meta > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .menu__meta .meta:not(.meta--accent) {
    color: var(--paper-100);
  }

  .social-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }

  .social-inline svg {
    flex: 0 0 auto;
  }

  /* ---------- Page ---------- */
  .page {
    position: relative;
    z-index: 10;
    background: var(--ink-950);
    transition: opacity 0.4s var(--ease-out);
  }

  /* ---------- Footer ---------- */
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--ink-900);
    border-top: 1px solid var(--ink-600);
  }

