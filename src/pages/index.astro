---

<Base
  title="Flavien Gaujard — Développeur & designer d’interfaces"
  description="Portfolio de Flavien Gaujard, développeur full-stack et designer d’interfaces à Annecy. React, TypeScript, Java, design systems et photographie."
>
  <!-- ====================== HERO ====================== -->
  <section class="hero" id="hero">
    <figure class="hero__frame">
      <div class="hero__media" data-hero-parallax>
        <video src={backgroundVideo} autoplay muted loop playsinline />
      </div>
      <div class="hero__overlay" aria-hidden="true"></div>
    </figure>

    <p class="hero__corner hero__corner--tl meta" data-reveal>
      Index 00
    </p>
    <p class="hero__corner hero__corner--tr meta" data-reveal>
      Software Engineer
    </p>

    <div class="hero__content container">
      <h1 class="hero__title display">
        <span class="mask-line">
          <span data-hero-line>Flavien Gaujard</span>
        </span>
      </h1>
      <p class="hero__tagline" data-reveal>
        Ingénieur logiciel full-stack avec un intérêt singulier pour le design, la photographie, la
        musique et bien d'autres disciplines artistiques.
      </p>
    </div>

    <p class="hero__corner hero__corner--bl meta" data-reveal>
      Annecy, FR — DEPUIS 2024
    </p>
    <p class="hero__corner hero__corner--b hero__pill meta" data-reveal>
      <span class="hero__dot" aria-hidden="true"></span>
      Open to work
    </p>
    <p class="hero__corner hero__corner--br meta" data-reveal>
      Scroll ↓
    </p>
  </section>

  <!-- ====================== MANIFESTO ====================== -->
  <section class="manifesto section container">
    <p class="meta meta--accent" data-reveal>
      À propos — 01
    </p>
    <h2 class="manifesto__text display">
      <span class="mask-line">
        <span data-manifesto-line>Du design system au pipeline CI/CD,</span>
      </span>
      <span class="mask-line">
        <span data-manifesto-line>je conçois des architectures web</span>
      </span>
      <span class="mask-line">
        <span data-manifesto-line>maintenables, précises et durables.</span>
      </span>
    </h2>
    <p class="manifesto__note" data-reveal>
      Apprenti manager de l’ingénierie numérique, je poursuis actuellement ma dernière année de
      Mastère d’ingénierie avancée du logiciel.
    </p>
  </section>

  <!-- ====================== EXPERIENCES ====================== -->
  <section class="experience section container" id="experiences">
    <header class="section-head">
      <p class="meta meta--accent" data-reveal>
        Expérience — 02
      </p>
      <h2 class="section-title display" data-reveal>
        Parcours
      </h2>
    </header>

    <ul class="xp-list">
      {experiences.map((xp) => (
        <li class="xp-item" data-reveal>
          <details class="xp-details">
            <summary class="xp-summary">
              <span class="xp-summary__dates meta">
                <span>{xp.from}</span>
                <span>{xp.to}</span>
              </span>
              <span class="xp-summary__company display">{xp.company}</span>
              <span class="xp-summary__role">{xp.role}</span>
              <span class="xp-summary__arrow" aria-hidden="true">
                ↓
              </span>
            </summary>
            <div class="xp-body">
              <p class="meta">{xp.place}</p>
              <ul class="xp-missions">
                {xp.missions.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
          </details>
        </li>
      ))}
    </ul>

    <div class="education">
      <h2 class="section-title display" data-reveal>
        Formations
      </h2>

      <ul class="edu-list">
        {education.map((ed) => (
          <li class="edu-item" data-reveal>
            <details class="edu-details">
              <summary class="edu-summary">
                <span class="edu-summary__dates meta">
                  <span>{ed.from}</span>
                  <span>{ed.to}</span>
                </span>
                <span class="edu-summary__school display">{ed.school}</span>
                <span class="edu-summary__diploma">{ed.diploma}</span>
                <span class="edu-summary__arrow" aria-hidden="true">
                  ↓
                </span>
              </summary>
              <div class="edu-body">
                <ul class="edu-skills">
                  {ed.skills.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ====================== SKILLS ====================== -->
  <section class="stack section" id="skills" data-stack data-bg="#141110">
    <div class="stack__pin container">
      <header class="section-head stack__head">
        <div class="stack__head-main">
          <p class="meta meta--accent" data-reveal>
            Compétences — 03
          </p>
          <h2 class="section-title display" data-reveal>
            Ce que je sais faire
          </h2>
        </div>
      </header>

      <div class="stack__chapters">
        {skills.map((skill) => (
          <article class="stack__chapter" data-stack-chapter>
            <div class="stack__chapter-head">
              <p class="meta meta--accent">{skill.index} / 05</p>
              <h3 class="mask-line">
                <span class="stack__title display" data-stack-title>
                  {skill.title}
                </span>
              </h3>
              <p class="stack__desc" data-stack-desc>
                {skill.desc}
              </p>
            </div>
            <ul class="stack__list">
              {skill.stack.map((item) => (
                <li class="stack__item" data-stack-item>
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="stack__progress">
        <span data-stack-progress></span>
      </div>
    </div>
  </section>

  <!-- ====================== PROJECTS ====================== -->
  <section class="projects section container" id="projects" data-bg="#181412">
    <header class="section-head">
      <p class="meta meta--accent" data-reveal>
        Projets réalisés — 04
      </p>
      <h2 class="section-title display" data-reveal>
        De l'idée au produit final
      </h2>
      <p class="projects__intro" data-reveal>
        Une sélection de produits conçus entre exigence technique, direction artistique et usage
        réel.
      </p>
    </header>

    <div class="projects-carousel" data-projects-carousel data-reveal>
      <div class="projects-carousel__head">
        <div class="projects-carousel__controls">
          <button
            type="button"
            class="projects-carousel__arrow"
            data-projects-prev
            aria-label="Projet précédent"
          >
            ←
          </button>
          <button
            type="button"
            class="projects-carousel__arrow"
            data-projects-next
            aria-label="Projet suivant"
          >
            →
          </button>
        </div>
      </div>

      <div class="projects-carousel__viewport">
        <ul class="projects-carousel__track" data-projects-track>
          {projects.map((project) => (
            <li class="project-slide">
              <article class="project-card project-card--editorial" data-project-card>
                <div class="project-card__heading">
                  <p class="project-card__kicker meta">{project.index} / 05</p>
                  <p class="project-card__status meta">{project.status}</p>
                </div>

                <h3 class="project-card__title display">{project.title}</h3>

                <div class="project-card__layout">
                  <figure class="project-card__media">
                    <img
                      src={project.imgSrc}
                      alt={`Aperçu du projet ${project.title}`}
                      loading="lazy"
                    />
                  </figure>

                  <div class="project-card__main">
                    <p class="project-card__text">{project.desc}</p>

                    <div class="project-card__meta">
                      {(project.frontend ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">Frontend</p>
                          <p class="project-card__line">{(project.frontend ?? []).join(' · ')}</p>
                        </div>
                      )}
                      {(project.backend ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">Backend</p>
                          <p class="project-card__line">{(project.backend ?? []).join(' · ')}</p>
                        </div>
                      )}
                      {(project.devops ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">DevOps</p>
                          <p class="project-card__line">{(project.devops ?? []).join(' · ')}</p>
                        </div>
                      )}
                      {(project.tools ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">Outils</p>
                          <p class="project-card__line">{(project.tools ?? []).join(' · ')}</p>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ====================== MARQUEE ====================== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee-track>
      <span>Concevoir — Développer — Photographier — Mixer&nbsp;—&nbsp;</span>
      <span>Concevoir — Développer — Photographier — Mixer&nbsp;—&nbsp;</span>
    </div>
  </div>

  <!-- ====================== PHOTO GALLERY (horizontal travelling) ====================== -->
  <section class="gallery section" id="photos" data-gallery data-bg="#0b0a09">
    <div class="gallery__pin">
      <header class="section-head gallery__head container">
        <p class="meta meta--accent" data-reveal>
          Photographie — 05
        </p>
        <h2 class="section-title display" data-reveal>
          La chambre noire
        </h2>
        <p class="gallery__intro" data-reveal>
          Derrière l’écran, un boîtier. La pellicule défile — argentique et numérique.
        </p>
      </header>

      <div class="gallery__wrap">
        <div class="gallery__track" data-gallery-track>
          {photos.map((photo, i) => (
            <figure class="gallery__frame" data-gallery-frame>
              <p class="gallery__frame-head meta">
                <span>N°{String(i + 1).padStart(2, '0')}</span>
                <span>{photo.place}</span>
              </p>
              <button
                type="button"
                class="gallery__media"
                data-photo-zoom
                aria-label={`Agrandir la photo ${String(i + 1).padStart(2, '0')}`}
              >
                <img src={photo.src} alt={photo.alt} loading="lazy" />
              </button>
              <figcaption class="gallery__caption meta">
                <span>{photo.label}</span>
                <span>{photo.exif}</span>
              </figcaption>
            </figure>
          ))}
          <div class="gallery__frame gallery__frame--end">
            <p class="meta meta--accent">Fin de pellicule</p>
            <a href="#contact" class="gallery__end-link display" data-nav-link>
              La suite s’écrit ensemble&nbsp;→
            </a>
          </div>
        </div>
      </div>

      <div class="gallery__hud container">
        <p class="meta">
          <span data-gallery-current>01</span> / {String(photos.length).padStart(2, '0')}
        </p>
        <div class="gallery__progress">
          <span data-gallery-progress></span>
        </div>
        <p class="meta">Défiler&nbsp;↓</p>
      </div>
    </div>
  </section>

  <div class="photo-lightbox" data-photo-lightbox aria-hidden="true">
    <figure class="photo-lightbox__frame">
      <img class="photo-lightbox__image" data-photo-lightbox-image alt="" />
      <button
        type="button"
        class="photo-lightbox__close meta"
        data-photo-lightbox-close
        aria-label="Fermer la photo plein écran"
      >
        Fermer ×
      </button>
    </figure>
  </div>

  <!-- ====================== OFF SCREEN ====================== -->
  <section class="life section container" id="offscreen" data-bg="#1c1815">
    <header class="section-head">
      <p class="meta meta--accent" data-reveal>
        Hors écran — 06
      </p>
      <h2 class="section-title display" data-reveal>
        Éveil et exutoire
      </h2>
    </header>

    <div class="life__grid">
      <div class="life-block" data-reveal>
        <p class="meta meta--accent">(01)</p>
        <h3 class="life-block__title display">L’oreille et l’œil</h3>
        <ul class="life-block__list">
          <li>DJing & M.A.O</li>
          <li>Photographie</li>
          <li>Cinéma, séries & documentaires</li>
          <li>Littérature</li>
        </ul>
      </div>
      <div class="life-block" data-reveal>
        <p class="meta meta--accent">(02)</p>
        <h3 class="life-block__title display">Le souffle</h3>
        <ul class="life-block__list">
          <li>Course à pied</li>
          <li>Vélo</li>
          <li>Randonnée</li>
        </ul>
      </div>
      <div class="life-block" data-reveal>
        <p class="meta meta--accent">(03)</p>
        <h3 class="life-block__title display">Le collectif</h3>
        <ul class="life-block__list">
          <li>Président — PSK, association socio-culturelle (Chartres)</li>
          <li>Membre — La Gentiane, monnaie locale (Annecy)</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Sections & storytelling ---------- */
  /* ---------- Section head ---------- */
  .section-head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: var(--text-h2);
    color: var(--paper-50);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: var(--space-7) var(--space-6);
  }

  .hero__frame {
    position: absolute;
    inset: var(--space-4);
    top: 0;

    overflow: hidden;
    border-radius: 0 0 1.5rem 1.5rem;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: -12% 0;
    will-change: transform;
    border-radius: inherit;
    overflow: hidden;
  }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) sepia(0.12) contrast(1.02);
    border-radius: inherit;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--ink-950) 92%, transparent) 0%,
      color-mix(in srgb, var(--ink-950) 45%, transparent) 38.2%,
      color-mix(in srgb, var(--ink-950) 18%, transparent) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: min-content;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-bottom: var(--space-5);
  }

  .hero__title {
    font-size: var(--text-hero);
    color: var(--paper-50);
    width: 100%;
    text-wrap: nowrap;
    translate: -6px 0;
  }

  .hero__tagline {
    font-size: var(--text-lg);
    color: var(--paper-100);
    text-wrap: balance;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--ink-600);
    border-radius: 999px;
    color: var(--paper-100);
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .hero__corner {
    position: absolute;
    z-index: 2;
  }

  .hero__corner--tl {
    top: 25%;
    left: var(--margin-x);
  }
  .hero__corner--tr {
    top: 25%;
    right: var(--margin-x);
  }
  .hero__corner--bl {
    bottom: var(--space-5);
    left: var(--margin-x);
  }
  .hero__corner--br {
    bottom: var(--space-5);
    right: var(--margin-x);
  }
  .hero__corner--b {
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
  }

  /* ---------- Manifesto ---------- */
  .manifesto {
    display: grid;
    gap: var(--space-5);
  }

  .manifesto__text {
    font-size: var(--text-h2);
    max-width: 40ch;
    width: 100%;
    color: var(--paper-50);
  }

  .manifesto__text .mask-line {
    display: block;
  }

  .manifesto__text [data-manifesto-line] {
    display: block;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .manifesto__note {
    max-width: 55ch;
    margin-left: auto;
    color: var(--ink-300);
  }

  /* ---------- Experiences ---------- */
  .xp-list {
    list-style: none;
  }

  .xp-item {
    border-top: 1px solid var(--ink-600);
  }

  .xp-item:last-child {
    border-bottom: 1px solid var(--ink-600);
  }

  .xp-summary {
    display: grid;
    grid-template-columns: minmax(18ch, 24ch) minmax(0, 1fr) minmax(0, 1.618fr) auto;
    align-items: end;
    gap: var(--space-4);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .xp-summary__dates {
    display: grid;
    gap: 0.1rem;
    line-height: 1.2;
  }

  .xp-summary__dates > span {
    display: block;
    white-space: nowrap;
  }

  .xp-summary__dates > span + span {
    padding-left: 2ch;
  }

  .xp-summary::-webkit-details-marker {
    display: none;
  }

  .xp-summary:hover .xp-summary__company {
    color: var(--rust-400);
  }

  .xp-summary__company {
    font-size: var(--text-h3);
    color: var(--paper-50);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .xp-summary__role {
    color: var(--ink-300);
  }

  .xp-summary__arrow {
    font-size: var(--text-h3);
    color: var(--rust-500);
    align-self: start;
    transition: transform var(--dur-roll) var(--ease-out);
  }

  .xp-details[open] .xp-summary__arrow {
    transform: rotate(180deg);
  }

  .xp-body {
    display: grid;
    gap: var(--space-3);
    padding: 0 0 0 calc(24ch + var(--space-4));
    max-width: 70ch;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-0.35rem);
    transition:
      max-height 420ms var(--ease-out),
      opacity 280ms var(--ease-out),
      transform 420ms var(--ease-out),
      padding-bottom 420ms var(--ease-out);
  }

  .xp-details[open] .xp-body {
    max-height: 40rem;
    opacity: 1;
    transform: translateY(0);
    padding-bottom: var(--space-5);
    animation: accordion-reveal 520ms var(--ease-out);
  }

  .xp-missions {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.2em;
    color: var(--paper-100);
  }

  /* ---------- Education ---------- */
  .education {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .edu-item {
    border-top: 1px solid var(--ink-600);
  }

  .edu-item:last-child {
    border-bottom: 1px solid var(--ink-600);
  }

  .edu-summary {
    display: grid;
    grid-template-columns: minmax(18ch, 24ch) minmax(0, 1fr) minmax(0, 1.618fr) auto;
    align-items: end;
    gap: var(--space-4);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .edu-summary::-webkit-details-marker {
    display: none;
  }

  .edu-summary__dates {
    display: grid;
    gap: 0.1rem;
    line-height: 1.2;
  }

  .edu-summary__dates > span {
    display: block;
    white-space: nowrap;
  }

  .edu-summary__dates > span + span {
    padding-left: 2ch;
  }

  .edu-summary:hover .edu-summary__school {
    color: var(--rust-400);
  }

  .edu-summary__school {
    font-size: var(--text-h3);
    color: var(--paper-50);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .edu-summary__diploma {
    color: var(--ink-300);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .edu-summary__arrow {
    font-size: var(--text-h3);
    color: var(--rust-500);
    align-self: start;
    transition: transform var(--dur-roll) var(--ease-out);
  }

  .edu-details[open] .edu-summary__arrow {
    transform: rotate(180deg);
  }

  .edu-body {
    display: grid;
    gap: var(--space-3);
    padding: 0 0 0 calc(24ch + var(--space-4));
    max-width: 70ch;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-0.35rem);
    transition:
      max-height 420ms var(--ease-out),
      opacity 280ms var(--ease-out),
      transform 420ms var(--ease-out),
      padding-bottom 420ms var(--ease-out);
  }

  .edu-details[open] .edu-body {
    max-height: 26rem;
    opacity: 1;
    transform: translateY(0);
    padding-bottom: var(--space-5);
    animation: accordion-reveal 520ms var(--ease-out);
  }

  @keyframes accordion-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      clip-path: inset(0 0 0 0);
    }
  }

  .edu-skills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .edu-skills li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--ink-600);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-100);
  }

  /* ---------- Projects ---------- */
  .projects {
    --projects-bg: #181412;
    display: grid;
    gap: var(--space-6);
  }

  .projects__intro {
    max-width: 62ch;
    color: var(--ink-300);
  }

  .projects-carousel {
    display: grid;
    gap: var(--space-4);
  }

  .projects-carousel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .projects-carousel__count {
    color: var(--ink-300);
  }

  .projects-carousel__controls {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
  }

  .projects-carousel__arrow {
    width: 2.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--ink-600);
    color: var(--paper-50);
    background: color-mix(in srgb, var(--ink-900) 70%, transparent);
    font-size: 1.25rem;
    line-height: 1;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .projects-carousel__arrow:hover {
    color: var(--rust-400);
    border-color: var(--rust-500);
    background: color-mix(in srgb, var(--rust-700) 35%, transparent);
  }

  .projects-carousel__viewport {
    --shadow-cycle-duration: 550ms;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    padding-block: var(--space-3);
  }

  .projects-carousel__viewport::before,
  .projects-carousel__viewport::after {
    content: '';
    position: absolute;
    top: var(--space-3);
    bottom: var(--space-3);
    width: clamp(28px, 5vw, 72px);
    pointer-events: none;
    z-index: 2;
  }

  .projects-carousel__viewport::before {
    left: 0;
    opacity: 0;
    transform-origin: left center;
    transform: scaleX(0.06);
    background: linear-gradient(
      to right,
      var(--projects-bg) 0%,
      var(--projects-bg) 22%,
      color-mix(in srgb, var(--projects-bg) 78%, transparent) 52%,
      transparent 100%
    );
  }

  .projects-carousel__viewport.is-sliding::before {
    animation: projects-left-shadow-cycle var(--shadow-cycle-duration) linear;
  }

  @keyframes projects-left-shadow-cycle {
    0% {
      opacity: 0;
      transform: scaleX(0.06);
    }
    32% {
      opacity: 1;
      transform: scaleX(1);
    }
    100% {
      opacity: 0;
      transform: scaleX(0);
    }
  }

  .projects-carousel__viewport::after {
    right: 0;
    opacity: 1;
    background: linear-gradient(
      to left,
      var(--projects-bg) 0%,
      var(--projects-bg) 22%,
      color-mix(in srgb, var(--projects-bg) 78%, transparent) 52%,
      transparent 100%
    );
  }

  .projects-carousel__track {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .project-slide {
    flex: 0 0 clamp(640px, 86vw, 1240px);
  }

  .project-card {
    display: grid;
    gap: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--ink-600) 80%, transparent);
    padding: var(--space-6);
    background: linear-gradient(
      120deg,
      color-mix(in srgb, var(--ink-900) 84%, transparent),
      color-mix(in srgb, var(--ink-950) 88%, transparent)
    );
    height: 100%;
  }

  .project-card__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project-card__status {
    color: var(--rust-400);
  }

  .project-card__layout {
    display: grid;
    grid-template-columns: minmax(340px, 43%) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-6);
  }

  .project-card__media {
    margin: 0;
    width: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--ink-600) 74%, transparent);
    background: var(--ink-900);
  }

  .project-card__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.88) sepia(0.06) contrast(1.02);
  }

  .project-card__main {
    display: grid;
    gap: var(--space-5);
  }

  .project-card__title {
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    letter-spacing: -0.025em;
    color: var(--paper-50);
    max-width: 16ch;
  }

  .project-card__text {
    color: var(--ink-300);
    max-width: 58ch;
    line-height: 1.78;
    font-size: clamp(1rem, 1.2vw, 1.08rem);
  }

  .project-card__meta {
    display: grid;
    gap: var(--space-3);
  }

  .project-card__meta-row {
    display: grid;
    grid-template-columns: minmax(8ch, 10ch) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-top: var(--space-2);
    border-top: 1px solid color-mix(in srgb, var(--ink-600) 66%, transparent);
  }

  .project-card__line {
    color: var(--paper-100);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.04em;
    line-height: 1.65;
    text-transform: uppercase;
  }

  .photo-lightbox {
    position: fixed;
    inset: 0;
    z-index: 170;
    opacity: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--ink-950) 92%, transparent);
  }

  .photo-lightbox.is-open {
    pointer-events: auto;
  }

  .photo-lightbox__close {
    position: fixed;
    z-index: 175;
    border: 1px solid var(--ink-600);
    background: color-mix(in srgb, var(--ink-900) 75%, transparent);
    color: var(--paper-50);
    padding: var(--space-2) var(--space-3);
    opacity: 0;
    transition:
      opacity 220ms var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .photo-lightbox__close:hover {
    color: var(--rust-400);
    border-color: var(--rust-500);
  }

  .photo-lightbox__frame {
    position: fixed;
    inset: 0;
    margin: 0;
    display: block;
  }

  .photo-lightbox__image {
    position: fixed;
    max-width: none;
    object-fit: cover;
    will-change: top, left, width, height;
    box-shadow: 0 24px 80px color-mix(in srgb, black 70%, transparent);
  }

  /* ---------- Toolbox (pinned chapters) ---------- */
  .stack[data-enhanced] {
    padding-block: 0;
  }

  .stack__pin {
    display: grid;
    gap: var(--space-6);
  }

  .stack[data-enhanced] .stack__pin {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-6);
  }

  .stack__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .stack__head-main {
    display: grid;
    gap: var(--space-3);
  }

  .stack__chapters {
    display: grid;
    gap: var(--space-7);
  }

  .stack[data-enhanced] .stack__chapters {
    display: block;
    position: relative;
    min-height: min(52vh, 480px);
  }

  .stack__chapter {
    display: grid;
    grid-template-columns: 1fr 1.618fr;
    gap: var(--space-5) var(--space-6);
    align-items: start;
  }

  .stack[data-enhanced] .stack__chapter {
    position: absolute;
    inset: 0;
  }

  .stack__chapter-head {
    display: grid;
    gap: var(--space-3);
  }

  .stack__title {
    font-size: var(--text-h2);
    color: var(--paper-50);
  }

  .stack__desc {
    max-width: 34ch;
    color: var(--ink-300);
  }

  .stack__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-content: start;
  }

  .stack__item {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--ink-600);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-100);
  }

  .stack__progress {
    display: none;
    height: 1px;
    background: var(--ink-600);
  }

  .stack[data-enhanced] .stack__progress {
    display: block;
  }

  .stack__progress span {
    display: block;
    height: 100%;
    background: var(--rust-500);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ---------- Marquee ---------- */
  .marquee {
    overflow: hidden;
    padding-block: var(--space-5);
    margin-block: var(--space-6);
    border-block: 1px solid var(--ink-800);
  }

  .marquee__track {
    display: flex;
    gap: var(--space-4);
    width: max-content;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink-600);
  }

  /* ---------- Gallery (travelling horizontal) ---------- */
  .gallery[data-enhanced] {
    padding-block: 0;
    overflow: hidden;
  }

  .gallery__pin {
    display: grid;
    gap: var(--space-6);
  }

  .gallery[data-enhanced] .gallery__pin {
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: var(--space-6) var(--space-5);
  }

  .gallery__head {
    margin-bottom: 0;
  }

  .gallery__intro {
    max-width: 45ch;
    color: var(--ink-300);
  }

  .gallery__wrap {
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .gallery__wrap::-webkit-scrollbar {
    display: none;
  }

  .gallery[data-enhanced] .gallery__wrap {
    overflow: visible;
  }

  .gallery__track {
    display: flex;
    gap: var(--space-6);
    width: max-content;
    padding-inline: var(--margin-x);
    align-items: center;
  }

  .gallery__frame {
    display: grid;
    gap: var(--space-2);
    scroll-snap-align: center;
  }

  .gallery__frame-head,
  .gallery__caption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .gallery__media {
    height: min(52vh, 520px);
    width: fit-content;
    overflow: hidden;
    background: var(--ink-800);
    border: 1px solid transparent;

    &:hover {
      border: 1px solid var(--rust-500);
    }
  }

  .gallery__media img {
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: contain;
    filter: saturate(0.85) sepia(0.1);
  }

  .gallery__frame--end {
    align-self: center;
    align-content: center;
    gap: var(--space-4);
    padding-inline: var(--space-6) var(--space-7);
  }

  .gallery__end-link {
    font-size: var(--text-h3);
    color: var(--paper-50);
    max-width: 14ch;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .gallery__end-link:hover {
    color: var(--rust-400);
  }

  .gallery__hud {
    display: none;
    align-items: center;
    gap: var(--space-5);
  }

  .gallery[data-enhanced] .gallery__hud {
    display: flex;
  }

  .gallery__progress {
    flex: 1;
    height: 1px;
    background: var(--ink-600);
  }

  .gallery__progress span {
    display: block;
    height: 100%;
    background: var(--rust-500);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* ---------- Off screen ---------- */
  .life__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6) var(--gutter);
  }

  .life-block {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink-600);
  }

  .life-block__title {
    font-size: var(--text-h3);
    color: var(--paper-50);
  }

  .life-block__list {
    list-style: none;
    display: grid;
    gap: var(--space-2);
    color: var(--paper-100);
  }

  .life-block__note {
    max-width: 34ch;
    font-size: var(--text-sm);
    color: var(--ink-300);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    .xp-summary {
      grid-template-columns: minmax(15ch, 20ch) minmax(0, 1fr) auto;
    }

    .xp-summary__role {
      grid-column: 2 / 4;
      grid-row: 2;
    }

    .xp-summary__dates {
      grid-column: 1;
      grid-row: 1;
    }

    .xp-body {
      padding-left: calc(20ch + var(--space-4));
    }

    .edu-summary {
      grid-template-columns: minmax(15ch, 20ch) minmax(0, 1fr) auto;
    }

    .edu-summary__diploma {
      grid-column: 2 / 4;
      grid-row: 2;
    }

    .edu-summary__dates {
      grid-column: 1;
      grid-row: 1;
    }

    .edu-body {
      padding-left: calc(20ch + var(--space-4));
    }

    .project-slide {
      flex-basis: min(92vw, 980px);
    }

    .project-card {
      padding: var(--space-5);
    }

    .project-card__layout {
      grid-template-columns: minmax(260px, 34%) minmax(0, 1fr);
      gap: var(--space-5);
    }

    .stack__chapter {
      grid-template-columns: 1fr;
    }

    .stack[data-enhanced] .stack__chapters {
      min-height: min(64vh, 560px);
    }

    .life__grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 640px) {
    .hero__frame {
      inset: var(--space-2);
    }

    .xp-body {
      padding-left: 0;
    }

    .edu-body,
    .xp-body {
      padding-left: 0;
    }

    .edu-summary {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2) var(--space-3);
