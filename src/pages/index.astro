---

<Base
  title="Flavien Gaujard — Portfolio"
  description="Ingénieur logiciel full-stack avec un intérêt singulier pour le design, la photographie, la musique et bien d'autres disciplines."
>
  <!-- ====================== HERO ====================== -->
  <section class="hero" id="hero">
    <figure class="hero__frame">
      <div class="hero__media" data-hero-parallax>
        <video src={backgroundVideo} autoplay muted loop playsinline />
      </div>
      <div class="hero__overlay" aria-hidden="true"></div>
    </figure>

    <p class="hero__corner hero__corner--tl meta" data-reveal>
      00 — Index
    </p>
    <div class="hero__logo-wrap">
      <img
        class="hero__logo"
        src="/logo.svg"
        alt="Flavien Gaujard"
        width="48"
        height="48"
        data-reveal
      />
    </div>
    <p class="hero__corner hero__corner--tr meta" data-reveal>
      Software Engineer
    </p>

    <div class="hero__content container">
      <h1 class="hero__title display">
        <span class="mask-line">
          <span data-hero-line>Flavien Gaujard</span>
        </span>
      </h1>
      <p class="hero__tagline" data-reveal>
        Ingénieur logiciel full-stack avec un intérêt singulier pour le design, la photographie, la
        musique et bien d'autres disciplines.
      </p>
    </div>

    <p class="hero__corner hero__corner--bl meta" data-reveal>
      Annecy, FR — DEPUIS 2024
    </p>
    <p class="hero__corner hero__corner--b hero__pill meta" data-reveal>
      <span class="hero__dot" aria-hidden="true"></span>
      Open to work
    </p>
    <p class="hero__corner hero__corner--br meta" data-reveal>
      Scroll ↓
    </p>
  </section>

  <!-- ====================== MANIFESTO ====================== -->
  <section class="manifesto section container" data-bg="#1c1815">
    <p class="meta meta--accent" data-reveal>
      01 — À propos
    </p>
    <h2 class="manifesto__text display">
      <span class="mask-line">
        <span data-manifesto-line>Du design system au pipeline CI/CD,</span>
      </span>
      <span class="mask-line">
        <span data-manifesto-line>je conçois des architectures web</span>
      </span>
      <span class="mask-line">
        <span data-manifesto-line>maintenables, précises et durables.</span>
      </span>
    </h2>
    <p class="manifesto__note" data-reveal>
      Apprenti manager de l’ingénierie numérique, je poursuis actuellement ma dernière année de
      Mastère d’ingénierie avancée du logiciel.
    </p>
  </section>

  <!-- ====================== EXPERIENCES ====================== -->
  <section class="experience section container" id="experiences" data-bg="#1c1815">
    <header class="section-head">
      <p class="meta meta--accent" data-reveal>
        02 — Expériences
      </p>
      <h2 class="section-title display" data-reveal>
        Parcours professionnel
      </h2>
    </header>

    <ul class="xp-list">
      {experiences.map((xp) => (
        <li class="xp-item" data-reveal>
          <details class="xp-details">
            <summary class="xp-summary">
              <span class="xp-summary__dates meta">
                <span>{xp.from}</span>
                <span>{xp.to}</span>
              </span>
              <span class="xp-summary__company display">{xp.company}</span>
              <span class="xp-summary__role">{xp.role}</span>
              <span class="xp-summary__arrow" aria-hidden="true">
                ↓
              </span>
            </summary>
            <div class="xp-body">
              <p class="meta">{xp.place}</p>
              <div class="xp-description">
                {xp.desc.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <ul class="xp-missions">
                {xp.missions.map((m) => (
                  <li>{m}</li>
                ))}
              </ul>
            </div>
          </details>
        </li>
      ))}
    </ul>

    <div class="education">
      <h2 class="section-title display" data-reveal>
        Diplômes et formations
      </h2>

      <ul class="edu-list">
        {education.map((ed) => (
          <li class="edu-item" data-reveal>
            <details class="edu-details">
              <summary class="edu-summary">
                <span class="edu-summary__dates meta">
                  <span>{ed.from}</span>
                  <span>{ed.to}</span>
                </span>
                <span class="edu-summary__school display">{ed.school}</span>
                <span class="edu-summary__diploma">
                  <span>{ed.diploma}</span>
                  {ed.diplomaLvl && <span class="edu-summary__level meta">{ed.diplomaLvl}</span>}
                </span>
                <span class="edu-summary__arrow" aria-hidden="true">
                  ↓
                </span>
              </summary>
              <div class="edu-body">
                <ul class="edu-skills">
                  {ed.skills.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ====================== SKILLS ====================== -->
  <section class="stack section" id="skills" data-stack data-bg="#1c1815">
    <div class="stack__pin container">
      <header class="section-head stack__head">
        <div class="stack__head-main">
          <p class="meta meta--accent" data-reveal>
            03 — Compétences
          </p>
          <h2 class="section-title display" data-reveal>
            Ce que je sais faire
          </h2>
        </div>
      </header>

      <div class="stack__chapters">
        {skills.map((skill) => (
          <article class="stack__chapter" data-stack-chapter>
            <div class="stack__chapter-head">
              <p class="meta meta--accent">{skill.index} / 05</p>
              <h3 class="mask-line">
                <span class="stack__title display" data-stack-title>
                  {skill.title}
                </span>
              </h3>
              <p class="stack__desc" data-stack-desc>
                {skill.desc}
              </p>
            </div>
            <div class="stack__toolbox">
              <div class="stack__panels" aria-hidden="true">
                <span class="stack__panel stack__panel--deep" data-stack-panel></span>
                <span class="stack__panel stack__panel--rust" data-stack-panel></span>
              </div>
              <div class="stack__sheet" data-stack-sheet>
                <div class="stack__sheet-head">
                  <p class="meta">{skill.label}</p>
                </div>
                <ul class="stack__list">
                  {skill.stack.map((item) => (
                    <li class="stack__item" data-stack-item>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="stack__progress">
        <span data-stack-progress></span>
      </div>
    </div>
  </section>

  <!-- ====================== PROJECTS ====================== -->
  <section class="projects section container" id="projects" data-bg="#1c1815">
    <header class="section-head">
      <p class="meta meta--accent" data-reveal>
        04 — Projets réalisés
      </p>
      <h2 class="section-title display" data-reveal>
        De l'idée au produit final
      </h2>
      <p class="projects__intro" data-reveal>
        Une sélection de produits conçus entre exigence technique, direction artistique et usage
        réel.
      </p>
    </header>

    <div class="projects-carousel" data-projects-carousel data-reveal>
      <div class="projects-carousel__head">
        <div class="timer-combined" data-projects-timer aria-hidden="true">
          <span class="timer-digits" data-projects-seconds>
            05s
          </span>
          <div class="projects-carousel__timer">
            <span class="projects-carousel__timer-fill"></span>
          </div>
        </div>
        <div class="projects-stepper" data-projects-stepper hidden>
          {projects.map((project) => (
            <button
              type="button"
              class="projects-stepper__dot"
              data-projects-step
              aria-label={`Afficher ${project.title}`}
            ></button>
          ))}
        </div>
        <div class="projects-carousel__controls">
          <button
            type="button"
            class="projects-carousel__arrow"
            data-projects-pause
            aria-label="Mettre le défilement automatique en pause"
            title="Mettre le défilement automatique en pause"
            hidden
          >
            <span data-projects-pause-icon aria-hidden="true">
              Ⅱ
            </span>
          </button>
          <button
            type="button"
            class="projects-carousel__arrow"
            data-projects-prev
            aria-label="Projet précédent"
          >
            ←
          </button>
          <button
            type="button"
            class="projects-carousel__arrow"
            data-projects-next
            aria-label="Projet suivant"
          >
            →
          </button>
        </div>
      </div>

      <div class="projects-carousel__viewport">
        <ul class="projects-carousel__track" data-projects-track>
          {projects.map((project) => (
            <li class="project-slide">
              <article class="project-card project-card--editorial" data-project-card>
                <div class="project-card__heading">
                  <p class="project-card__kicker meta">{project.index} / 05</p>
                  <p class="project-card__status meta">{project.status}</p>
                </div>
                <p class="project-card__team meta">
                  {project.team ? 'Projet en entreprise' : 'Projet personnel'}
                </p>
                <h3 class="project-card__title display">{project.title}</h3>

                <div class="project-card__layout">
                  <figure class="project-card__media">
                    <img
                      src={project.imgSrc}
                      alt={`Aperçu du projet ${project.title}`}
                      loading="lazy"
                    />
                  </figure>

                  <div class="project-card__main">
                    <p class="project-card__text">{project.desc}</p>

                    <div class="project-card__meta">
                      {(project.frontend ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">Frontend</p>
                          <p class="project-card__line">{(project.frontend ?? []).join(' · ')}</p>
                        </div>
                      )}
                      {(project.backend ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">Backend</p>
                          <p class="project-card__line">{(project.backend ?? []).join(' · ')}</p>
                        </div>
                      )}
                      {(project.devops ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">DevOps</p>
                          <p class="project-card__line">{(project.devops ?? []).join(' · ')}</p>
                        </div>
                      )}
                      {(project.tools ?? []).length > 0 && (
                        <div class="project-card__meta-row">
                          <p class="meta">Outils</p>
                          <p class="project-card__line">{(project.tools ?? []).join(' · ')}</p>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ====================== MARQUEE ====================== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee-track>
      <span>Concevoir · Développer · Photographier · Mixer&nbsp;·&nbsp;</span>
      <span>Concevoir · Développer · Photographier · Mixer&nbsp;·&nbsp;</span>
    </div>
  </div>

  <!-- ====================== OFF SCREEN ====================== -->
  <section class="life section container" id="offscreen" data-bg="#1c1815">
    <header class="section-head">
      <p class="meta meta--accent" data-reveal>
        05 — Hors écran
      </p>
      <h2 class="section-title display" data-reveal>
        Éveil et exutoire
      </h2>
    </header>

    <div class="life__grid">
      <div class="life-block" data-reveal>
        <p class="meta meta--accent">(01)</p>
        <h3 class="life-block__title display">L’oreille et l’œil</h3>
        <ul class="life-block__list">
          <li>DJing & M.A.O</li>
          <li>Photographie</li>
          <li>Cinéma, séries & documentaires</li>
          <li>Littérature</li>
        </ul>
      </div>
      <div class="life-block" data-reveal>
        <p class="meta meta--accent">(02)</p>
        <h3 class="life-block__title display">Le corps et le souffle</h3>
