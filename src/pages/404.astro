---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page introuvable — Flavien Gaujard"
  description="La page demandée n'existe pas ou plus."
  showLoader={false}
>
  <section class="not-found section container">
    <p class="meta meta--accent">Erreur 404</p>
    <h1 class="not-found__title display">Page introuvable</h1>
    <p class="not-found__text">
      Cette page n'existe pas, a été déplacée, ou l'adresse comporte une erreur.
    </p>
    <a href="/" class="not-found__link display">
      <span class="mask-line">
        <span>Retour à l'accueil&nbsp;→</span>
      </span>
    </a>
  </section>
</Base>

<style>
  .not-found {
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    padding-top: clamp(var(--space-7), 14vw, var(--space-8));
  }

  .not-found__title {
    max-width: 14ch;
    color: var(--paper-50);
    font-size: clamp(3.4375rem, 9vw, 6.875rem);
  }

  .not-found__text {
    max-width: 48ch;
    color: var(--ink-300);
    font-size: var(--text-lg);
  }

  .not-found__link {
    justify-self: start;
    margin-top: var(--space-3);
    color: var(--rust-400);
    font-size: var(--text-h3);
    overflow: hidden;
  }

  .not-found__link:hover {
    color: var(--rust-500);
  }
</style>
